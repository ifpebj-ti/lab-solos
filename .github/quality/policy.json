  "modules": [
    {
      "name": "automacao",
      "prefixes": [".github/", "frontend/e2e/"]
    },
    {
      "name": "backend-testes",
      "prefixes": ["backend/Tests/"]
    },
    {
      "name": "backend-autenticacao",
      "prefixes": [
        "backend/src/Auth/",
        "backend/src/Controllers/Auth/",
        "backend/LabSolos-Server-DotNet8/Services/Security/",
        "backend/LabSolos-Server-DotNet8/Controllers/AuthController.cs"
      ]
    },
    {
      "name": "backend-usuarios-aprovacao",
      "prefixes": [
        "backend/src/Users/",
        "backend/src/Controllers/Users/",
        "backend/LabSolos-Server-DotNet8/Controllers/UsuariosController.cs",
        "backend/LabSolos-Server-DotNet8/Services/UsuarioService.cs"
      ]
    },
    {
      "name": "backend-emprestimos-estoque",
      "prefixes": [
        "backend/src/Loans/",
        "backend/src/Controllers/Loans/",
        "backend/LabSolos-Server-DotNet8/Controllers/EmprestimosController.cs",
        "backend/LabSolos-Server-DotNet8/Services/ProdutoService.cs"
      ]
    },
    {
      "name": "backend-compartilhado",
      "prefixes": ["backend/"]
    },
    {
      "name": "frontend-testes",
      "prefixes": ["frontend/src/test/", "frontend/src/__tests__/"]
    },
    {
      "name": "frontend-autenticacao",
      "prefixes": [
        "frontend/src/pages/Login",
        "frontend/src/pages/ChangePassword",
        "frontend/src/pages/ResetPassword"
      ]
    },
    {
      "name": "frontend-cadastro-aprovacao",
      "prefixes": ["frontend/src/pages/CreateAccount", "frontend/src/pages/RegistrationRequests"]
    },
    {
      "name": "frontend-emprestimos",
      "prefixes": ["frontend/src/pages/LoansRequest", "frontend/src/contracts/loan"]
    },
    {
      "name": "frontend-compartilhado",
      "prefixes": ["frontend/src/"]
    }
  ],
  "exclusions": [
    "**/node_modules/**",
    "**/bin/**",
    "**/obj/**",
    "**/dist/**",
    "**/.tmp/**"
  ]
}
