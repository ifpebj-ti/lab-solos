[Unit]
Description=Atualiza o LabOn a partir da release estável mais recente no GitHub
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
SupplementaryGroups=docker
WorkingDirectory=/opt/labon
Environment=LABON_DEPLOY_DIR=/opt/labon
ExecStart=/opt/labon/infra/oci/scripts/update-from-github.sh
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true

[Install]
WantedBy=multi-user.target
