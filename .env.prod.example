# Exemplo sintético para produção. Copie para .env.prod e configure valores reais.
# docker compose --env-file .env.prod -f docker-compose-prod.yml up -d
# Nunca publique o arquivo preenchido. Use uma release existente no GHCR.
APP_DOMAIN=labon.example.invalid
LABON_IMAGE_VERSION=2.7.1
LABON_FRONTEND_IMAGE=ghcr.io/ifpebj-ti/lab-solos-frontend
LABON_BACKEND_IMAGE=ghcr.io/ifpebj-ti/lab-solos-backend
VITE_API_URL=https://labon.example.invalid/api/
ASPNETCORE_ENVIRONMENT=Production
DB_NAME=labon
DB_USER=labon
DB_PASSWORD=SUBSTITUA_SENHA_DO_BANCO
EMAIL_SMTP_HOST=smtp.example.invalid
EMAIL_SMTP_PORT=587
EMAIL_USUARIO=SUBSTITUA_USUARIO_SMTP
EMAIL_SENHA=SUBSTITUA_SENHA_SMTP
EMAIL_DE=labon@example.invalid
JWT_KEY=SUBSTITUA_POR_UMA_CHAVE_ALEATORIA_COM_PELO_MENOS_32_CARACTERES
JWT_ISSUER=labon
JWT_AUDIENCE=labon
JWT_EXPIRES_IN_MINUTES=60
SEED_ADMIN_EMAIL=admin@example.invalid
SEED_ADMIN_PASSWORD=SUBSTITUA_SENHA_FORTE_DO_ADMIN
ALLOWED_HOSTS=labon.example.invalid;backend;localhost
